{
  "name": "wirescope",
  "version": "0.1.0",
  "description": "In-app network inspector and API explorer for React — like React Query Devtools, but for every request your app makes.",
  "license": "MIT",
  "author": "aziz-codes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "devtools",
    "network",
    "inspector",
    "api",
    "explorer",
    "fetch",
    "xhr",
    "debug",
    "tailwindcss"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite playground",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:playground": "vite build playground",
    "preview": "vite preview playground",
    "prepare": "tsup",
    "deploy:demo": "./scripts/deploy-demo.sh"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
